---
import Layout from '../../components/Layout.astro';

// Función obligatoria de Astro para crear las páginas de cada ID
export async function getStaticPaths() {
  const response = await fetch('https://dummyjson.com/recipes?limit=50');
  const data = await response.json();
  
  // Generamos una ruta para cada receta usando su ID
  return data.recipes.map((recipe: any) => ({
    params: { id: recipe.id.toString() },
    props: { recipe }, // Le pasamos los datos de esa receta específica como props
  }));
}

// Recuperamos la receta actual
const { recipe } = Astro.props as any;
---

<Layout title={recipe.name}>
  <a href="/recetas" style="color: #ff6600; display: inline-block; margin-bottom: 20px;">← Volver atrás</a>

  <h1 style="margin-bottom: 15px;">{recipe.name}</h1>
  
  <img src={recipe.image} alt={recipe.name} style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 20px;" />

  <div style="background: #eee; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
    <p>🌐 <strong>Cocina:</strong> {recipe.cuisine}</p>
    <p>📊 <strong>Dificultad:</strong> {recipe.difficulty}</p>
    <p>⏱️ <strong>Tiempo de preparación:</strong> {recipe.prepTimeMinutes} minutos</p>
    <p>🍽️ <strong>Porciones:</strong> {recipe.servings}</p>
  </div>

  <div style="margin-bottom: 20px;">
    <h2>Ingredientes:</h2>
    <ul style="padding-left: 20px; margin-top: 10px;">
      {recipe.ingredients.map((ing: string) => <li style="margin-bottom: 5px;">{ing}</li>)}
    </ul>
  </div>

  <div>
    <h2>Instrucciones:</h2>
    <ol style="padding-left: 20px; margin-top: 10px;">
      {recipe.instructions.map((step: string) => <li style="margin-bottom: 10px;">{step}</li>)}
    </ol>
  </div>
</Layout>