---
import Layout from "../layouts/Layout.astro";
import GameCard from "../components/GameCard.astro";

const API_URL =
  import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

let juegosDestacados = [];
let errorDestacados = "";

try {
  const response = await fetch(
    `${API_URL}/api/juegos?page=1&limit=4&orden=puntuacion_desc`
  );

  if (!response.ok) {
    throw new Error(
      "No se pudieron cargar los juegos destacados"
    );
  }

  const resultado = await response.json();

  juegosDestacados = resultado.data;
} catch (error) {
  errorDestacados =
    "No se pudieron cargar los juegos destacados";
}
---

<Layout
  title="MatchGame | Encuentra tu próximo videojuego"
  description="Descubre videojuegos, explora nuestro catálogo y encuentra tu próxima aventura con MatchGame."
>
  <section class="hero">
    <div class="container hero__content">
      <p class="hero__eyebrow">
        Descubre. Explora. Juega.
      </p>

      <h1>
        Encuentra tu próximo juego
      </h1>

      <p class="hero__description">
        Explora videojuegos, compara géneros y plataformas
        y descubre nuevas aventuras con MatchGame.
      </p>

      <form
        class="hero-search"
        action="/catalogo"
        method="get"
      >
        <label
          class="sr-only"
          for="buscar-inicio"
        >
          Buscar videojuego
        </label>

        <input
          id="buscar-inicio"
          type="search"
          name="buscar"
          placeholder="Buscar por título..."
        />

        <button type="submit">
          Buscar
        </button>
      </form>

      <a
        class="hero__catalog-link"
        href="/catalogo"
      >
        Explorar catálogo
      </a>
    </div>
  </section>

  <section class="featured container">
    <div class="section-heading">
      <div>
        <p class="section-heading__eyebrow">
          Recomendados
        </p>

        <h2>
          Juegos destacados
        </h2>

        <p>
          Algunos de los videojuegos mejor valorados
          de nuestro catálogo.
        </p>
      </div>

      <a href="/catalogo">
        Ver catálogo completo →
      </a>
    </div>

    {
      errorDestacados ? (
        <p class="featured__status">
          {errorDestacados}
        </p>
      ) : (
        <div class="featured-grid">
          {
            juegosDestacados.map((juego: any) => (
              <GameCard
                id={juego.id}
                titulo={juego.titulo}
                imagen={juego.imagen}
                puntuacion={juego.puntuacion}
                genero={juego.genero}
              />
            ))
          }
        </div>
      )
    }
  </section>

  <section class="selection-section">
    <div class="container selection-section__content">
      <div>
        <p class="section-heading__eyebrow">
          Selección MatchGame
        </p>

        <h2>
          No todos los juegos se recuerdan igual
        </h2>

        <p>
          Nuestra selección editorial destaca videojuegos
          imprescindibles, joyas ocultas y experiencias
          que creemos que merece la pena descubrir.
        </p>
      </div>

      <div class="selection-tags">
        <span>Imprescindible</span>
        <span>Joya oculta</span>
        <span>Desafiante</span>
        <span>Ideal con amigos</span>
      </div>
    </div>
  </section>

  <section class="discover container">
    <div class="discover__card">
      <div>
        <p class="section-heading__eyebrow">
          ¿No sabes qué jugar?
        </p>

        <h2>
          Encuentra algo que encaje contigo
        </h2>

        <p>
          Utiliza la búsqueda, los filtros por género
          y plataforma y la ordenación de nuestro catálogo.
        </p>
      </div>

      <a href="/catalogo">
        Buscar videojuegos
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    min-height: 480px;
    place-items: center;
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 75% 35%,
        rgba(124, 58, 237, 0.22),
        transparent 35%
      ),
      var(--color-bg);
  }

  .hero__content {
    width: 100%;
    padding-block: var(--space-6);
  }

  .hero__eyebrow,
  .section-heading__eyebrow {
    margin-bottom: var(--space-1);
    color: var(--color-primary-secondary);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 750px;
    margin-bottom: var(--space-2);
  }

  .hero__description {
    max-width: 650px;
    margin-bottom: var(--space-3);
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .hero-search {
    display: flex;
    max-width: 650px;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .hero-search input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
  }

  .hero-search button {
    padding: 12px 20px;
    border: 0;
    border-radius: var(--radius-small);
    background-color: var(--color-primary);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .hero__catalog-link {
    display: inline-block;
    color: var(--color-primary-secondary);
    font-weight: 600;
  }

  .featured {
    padding-block: var(--space-6);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .section-heading h2 {
    margin-bottom: var(--space-1);
  }

  .section-heading p:not(.section-heading__eyebrow) {
    color: var(--color-text-secondary);
  }

  .section-heading > a {
    flex-shrink: 0;
    color: var(--color-primary-secondary);
    font-weight: 600;
  }

  .featured-grid {
    display: grid;
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .featured__status {
    padding-block: var(--space-4);
    color: var(--color-error);
    text-align: center;
  }

  .selection-section {
    border-block: 1px solid var(--color-border);
    background-color: var(--color-bg-secondary);
  }

  .selection-section__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    padding-block: var(--space-6);
  }

  .selection-section h2 {
    margin-bottom: var(--space-2);
  }

  .selection-section p:not(.section-heading__eyebrow) {
    max-width: 650px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .selection-tags {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    align-content: center;
  }

  .selection-tags span {
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-card);
    font-weight: 600;
    text-align: center;
  }

  .discover {
    padding-block: var(--space-6);
  }

  .discover__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-card);
  }

  .discover__card h2 {
    margin-bottom: var(--space-1);
  }

  .discover__card p:not(.section-heading__eyebrow) {
    max-width: 650px;
    color: var(--color-text-secondary);
  }

  .discover__card > a {
    flex-shrink: 0;
    padding: 12px 18px;
    border-radius: var(--radius-small);
    background-color: var(--color-primary);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .selection-section__content {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: auto;
    }

    .hero-search {
      flex-direction: column;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .selection-tags {
      grid-template-columns: 1fr;
    }

    .discover__card {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>