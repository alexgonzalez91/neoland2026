---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Inicio | MatchGame"
  description="Encuentra tu próximo videojuego con MatchGame."
>
  <section class="hero">
    <div class="container">
      <h1>Encuentra tu próximo juego</h1>

      <p>
        Explora, filtra y descubre videojuegos seleccionados
        por MatchGame.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: var(--space-6);
  }

  .hero p {
    max-width: 600px;
    margin-top: var(--space-2);
  }
</style>