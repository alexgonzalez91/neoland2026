---
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return Array.from({ length: 50 }, (_, index) => ({
    params: {
      id: String(index + 1),
    },
  }));
}

const { id } = Astro.params;

const API_URL =
  import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

let juego = null;
let errorCarga = "";

try {
  const response = await fetch(
    `${API_URL}/api/juegos/${id}`
  );

  if (!response.ok) {
    errorCarga = "No se pudo cargar este videojuego";
  } else {
    const resultado = await response.json();
    juego = resultado.data;
  }
} catch (error) {
  errorCarga = "No se pudo conectar con la API";
}

const fechaFormateada = juego?.fecha_lanzamiento
  ? new Intl.DateTimeFormat("es-ES", {
      day: "2-digit",
      month: "long",
      year: "numeric",
      timeZone: "Europe/Madrid",
    }).format(new Date(juego.fecha_lanzamiento))
  : "Fecha no disponible";
---

<Layout
  title={
    juego
      ? `${juego.titulo} | MatchGame`
      : "Videojuego | MatchGame"
  }
  description={
    juego
      ? juego.descripcion
      : "Detalle de videojuego en MatchGame"
  }
>
  <section class="game-detail container">
    {errorCarga && (
      <div class="game-detail__status game-detail__status--error">
        <h1>No hemos podido cargar el videojuego</h1>
        <p>{errorCarga}</p>

        <a href="/catalogo">
          Volver al catálogo
        </a>
      </div>
    )}

    {!errorCarga && juego && (
      <>
        <a
          class="back-link"
          href="/catalogo"
        >
          ← Volver al catálogo
        </a>

        <div class="game-detail__main">
          <div class="game-detail__cover">
            {juego.imagen ? (
              <img
                src={juego.imagen}
                alt={`Carátula de ${juego.titulo}`}
              />
            ) : (
              <div class="game-detail__placeholder">
                MatchGame
              </div>
            )}
          </div>

          <div class="game-detail__info">
            <div class="game-detail__heading">
              <div>
                <p class="game-detail__genre">
                  {juego.genero}
                </p>

                <h1>{juego.titulo}</h1>
              </div>

              <span class="game-detail__score">
                {Number(juego.puntuacion).toFixed(1)}
              </span>
            </div>

            <p class="game-detail__description">
              {juego.descripcion}
            </p>

            <div class="game-detail__meta">
              <div class="meta-item">
                <span class="meta-item__label">
                  Fecha de lanzamiento
                </span>

                <span>
                  {fechaFormateada}
                </span>
              </div>

              <div class="meta-item">
                <span class="meta-item__label">
                  Género
                </span>

                <span>
                  {juego.genero}
                </span>
              </div>

              <div class="meta-item">
                <span class="meta-item__label">
                  Plataformas
                </span>

                <div class="platform-list">
                  {juego.plataformas.map((plataforma: string) => (
                    <span class="platform">
                      {plataforma}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        {juego.resena && (
          <section class="editorial-review">
            <div class="editorial-review__header">
              <div>
                <p class="editorial-review__eyebrow">
                  Selección MatchGame
                </p>

                <h2>Reseña editorial</h2>
              </div>

              <span class="editorial-review__score">
                {Number(
                  juego.resena.puntuacion
                ).toFixed(1)}
              </span>
            </div>

            {juego.resena.etiqueta && (
              <span class="editorial-review__tag">
                {juego.resena.etiqueta}
              </span>
            )}

            <p class="editorial-review__comment">
              {juego.resena.comentario}
            </p>
          </section>
        )}
      </>
    )}
  </section>
</Layout>

<style>
  .game-detail {
    padding-block: var(--space-5);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-3);
    color: var(--color-text-secondary);
  }

  .back-link:hover {
    color: var(--color-primary-secondary);
  }

  .game-detail__main {
    display: grid;
    grid-template-columns: minmax(250px, 360px) 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .game-detail__cover {
    overflow: hidden;
    aspect-ratio: 2 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-card);
  }

  .game-detail__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-detail__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .game-detail__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .game-detail__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .game-detail__heading h1 {
    margin-top: 4px;
  }

  .game-detail__genre {
    color: var(--color-primary-secondary);
    font-weight: 600;
  }

  .game-detail__score,
  .editorial-review__score {
    flex-shrink: 0;
    padding: 10px 14px;
    border-radius: var(--radius-small);
    background-color: var(--color-primary);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .game-detail__score {
    font-size: 1.25rem;
  }

  .game-detail__description {
    max-width: 750px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .game-detail__meta {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .meta-item {
    display: grid;
    gap: 6px;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .meta-item__label {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .platform-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .platform {
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background-color: var(--color-card);
    font-size: 0.875rem;
  }

  .editorial-review {
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-card);
  }

  .editorial-review__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .editorial-review__eyebrow {
    margin-bottom: 4px;
    color: var(--color-primary-secondary);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .editorial-review__tag {
    display: inline-block;
    margin-bottom: var(--space-2);
    padding: 6px 10px;
    border-radius: var(--radius-small);
    background-color: rgba(124, 58, 237, 0.15);
    color: var(--color-primary-secondary);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .editorial-review__comment {
    max-width: 850px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .game-detail__status {
    padding-block: var(--space-5);
    text-align: center;
  }

  .game-detail__status p {
    margin-block: var(--space-2);
  }

  .game-detail__status a {
    color: var(--color-primary-secondary);
  }

  .game-detail__status--error {
    color: var(--color-error);
  }

  @media (max-width: 768px) {
    .game-detail__main {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .game-detail__cover {
      width: min(100%, 360px);
      margin-inline: auto;
    }

    .game-detail__heading {
      gap: var(--space-2);
    }

    .editorial-review {
      padding: var(--space-3);
    }
  }
</style>